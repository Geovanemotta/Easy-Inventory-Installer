{
  "$schema": "https://meshcentral.com/schemas/config.json",
  "settings": {
    "cert": "inventario.giassi.com.br,localhost,127.0.0.1",
    "port": 4430,
    "aliasPort": 4443,
    "redirPort": 8086,
    "_redirAliasPort": 80,
    "trustedProxy": true,
    "ignoreAgentHashCheck": true,
    "allowFraming": true,
    "sessionSameSite": "none",
    "webrtc": true,
    "wanonly": false,
    "agentPong": 60,
    "minify": true,
    "maxInvalidLogin": {
      "time": 10,
      "count": 5,
      "coolofftime": 15
    },
    "maxInvalid2fa": {
      "time": 10,
      "count": 5,
      "coolofftime": 15
    }
  },
  "domains": {
    "": {
      "title": "Giassi - Acesso Remoto",
      "force2factor": true,
      "ignoreAgentHashCheck": true,
      "allowedOrigin": true,
      "minify": true,
      "newAccounts": true,
      "newAccountsRights": [
        "nonewgroups",
        "notools"
      ],
      "newAccountsUserGroups": [
        "ugrp//operadores_matriz"
      ],
      "userNameIsEmail": false,
      "hideMeshCentral": false,
      "auth": "ldap",
      "LDAPOptions": {
        "url": "ldaps://192.168.0.228:636",
        "tlsOptions": {
          "rejectUnauthorized": false
        },
        "bindDN": "serv_jumpserver@giassisuper.corp",
        "bindCredentials": "n3s)4(8SZb",
        "searchBase": "OU=giassisuper,DC=giassisuper,DC=corp",
        "searchFilter": "(&(objectClass=user)(sAMAccountName={{username}}))"
      },
      "LDAPUserKey": "sAMAccountName",
      "LDAPUserName": "displayName",
      "LDAPUserEmail": "mail",
      "LDAPUserGroups": "memberOf",
      "LDAPSiteAdminGroups": [
        "CN=G_TI_ADMIN,OU=Grupos,OU=TI,OU=Departamentos,OU=Matriz,OU=giassisuper,DC=giassisuper,DC=corp"
      ],
      "LDAPUserRequiredGroupMembership": [
        "CN=G_TI_ADMIN,OU=Grupos,OU=TI,OU=Departamentos,OU=Matriz,OU=giassisuper,DC=giassisuper,DC=corp",
        "CN=operador-matriz,OU=AD,OU=Grupos,OU=Servidores,OU=Matriz,OU=giassisuper,DC=giassisuper,DC=corp"
      ]
    },
    "local": {
      "siteStyle": 2,
      "title": "Giassi - Acesso Local (Admin)",
      "title2": "Autenticação Local de Contingência",
      "allowedOrigin": true,
      "minify": true,
      "newAccounts": true,
      "userNameIsEmail": false
    }
  }
}
