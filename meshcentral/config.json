{
  "$schema": "https://meshcentral.com/schemas/config.json",
  "settings": {
    "cert": "127.0.0.1,localhost",
    "port": 4430,
    "aliasPort": 4443,
    "redirPort": 8086,
    "_redirAliasPort": 80,
    "trustedProxy": true,
    "ignoreAgentHashCheck": true,
    "allowFraming": true,
    "sessionSameSite": "none",
    "webrtc": true,
    "wanonly": false,
    "agentPong": 60,
    "minify": true
  },
  "domains": {
    "": {
      "title": "Giassi - Acesso Remoto",
      "title2": "Controle Remoto de Estações de Trabalho",
      "certUrl": "https://127.0.0.1:4443/",
      "ignoreAgentHashCheck": true,
      "allowedOrigin": true,
      "minify": true,
      "newAccounts": true,
      "newAccountsRights": [
        "nonewgroups",
        "notools"
      ],
      "newAccountsUserGroups": [
        "ugrp//operadores_matriz"
      ],
      "userNameIsEmail": false,
      "hideMeshCentral": false
    },
    "local": {
      "title": "Giassi - Acesso Local (Admin)",
      "title2": "Autenticação Local de Contingência",
      "certUrl": "https://127.0.0.1:4443/local",
      "allowedOrigin": true,
      "minify": true,
      "newAccounts": true,
      "userNameIsEmail": false
    }
  }
}
