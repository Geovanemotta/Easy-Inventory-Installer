{
  "$schema": "https://meshcentral.com/schemas/config.json",
  "settings": {
    "cert": "localhost",
    "port": 4430,
    "aliasPort": 4443,
    "redirPort": 8086,
    "_redirAliasPort": 80,
    "trustedProxy": true,
    "ignoreAgentHashCheck": true,
    "allowFraming": true,
    "allowedFramingOrigins": "*",
    "sessionSameSite": "none",
    "webrtc": true,
    "wanonly": false,
    "agentPong": 60,
    "minify": true,
    "maxInvalidLogin": {
      "time": 10,
      "count": 5,
      "coolofftime": 15
    },
    "maxInvalid2fa": {
      "time": 10,
      "count": 5,
      "coolofftime": 15
    }
  },
  "domains": {
    "": {
      "title": "ZenithMap - Acesso Remoto",
      "force2factor": true,
      "ignoreAgentHashCheck": true,
      "allowedOrigin": true,
      "minify": true,
      "newAccounts": true,
      "newAccountsRights": [
        "nonewgroups",
        "notools"
      ],
      "newAccountsUserGroups": [
        "ugrp//operadores_matriz"
      ],
      "userNameIsEmail": false,
      "hideMeshCentral": false,
      "certUrl": "file:///opt/meshcentral/meshcentral-data/server.crt"
    },
    "local": {
      "siteStyle": 2,
      "title": "ZenithMap - Acesso Local (Admin)",
      "title2": "Autenticação Local de Contingência",
      "allowedOrigin": true,
      "minify": true,
      "newAccounts": true,
      "userNameIsEmail": false
    }
  }
}
